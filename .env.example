# Copy to .env.local and fill in. Never commit real values.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: Project Settings -> Database
# DATABASE_URL = pooled (transaction pooler, port 6543): ?pgbouncer=true&connection_limit=5&pool_timeout=30&connect_timeout=30
DATABASE_URL=
# DIRECT_URL = session/direct connection (port 5432), used for migrations
DIRECT_URL=

# Public base URL (share links, OG). http://localhost:3000 locally, the Vercel URL in production
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# true = show "Demo login" buttons and the Demo data badge. Seeded data is synthetic.
DEMO_MODE=true
